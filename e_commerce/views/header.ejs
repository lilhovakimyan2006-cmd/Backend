<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || "E-commerce" %></title>
    <style>
        :root { color-scheme: light; font-family: Arial, sans-serif; color: #202124; background: #f5f7fa; }
        * { box-sizing: border-box; }
        body { margin: 0; }
        header { background: #172554; color: #fff; }
        .site-nav { max-width: 1000px; margin: 0 auto; padding: 1rem; display: flex; gap: 1.5rem; align-items: center; }
        .site-nav strong { margin-right: auto; font-size: 1.15rem; }
        .site-nav a { color: #fff; text-decoration: none; }
        .site-nav a:hover { text-decoration: underline; }
        main { max-width: 1000px; margin: 2rem auto; padding: 0 1rem; }
        h1 { margin-top: 0; }
        .card-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }
        .card { background: #fff; border: 1px solid #dfe3eb; border-radius: 8px; padding: 1rem; }
        .card h2 { margin-top: 0; font-size: 1.15rem; }
        .muted { color: #5f6368; }
        .empty-state { background: #fff; border-radius: 8px; padding: 1rem; }
        form { display: grid; gap: 0.6rem; }
        input, button { font: inherit; padding: 0.65rem; }
        input { border: 1px solid #9aa0a6; border-radius: 4px; }
        button { border: 0; border-radius: 4px; background: #172554; color: #fff; cursor: pointer; }
        footer { max-width: 1000px; margin: 3rem auto 0; padding: 1rem; color: #5f6368; border-top: 1px solid #dfe3eb; }
    </style>
</head>
<body>
    <header>
        <nav class="site-nav" aria-label="Main navigation">
            <strong>E-commerce</strong>
            <a href="/products/page">Products</a>
            <a href="/orders/page">Orders</a>
            <a href="/auth/login">Log in</a>
            <a href="/auth/register">Register</a>
        </nav>
    </header>
