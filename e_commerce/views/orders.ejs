<%- include("header", { title: "Orders" }) %>
<main>
    <h1>Orders</h1>
    <% if (orders.length === 0) { %>
        <p class="empty-state">You have no orders yet.</p>
    <% } else { %>
        <div class="card-list">
            <% orders.forEach((order) => { %>
                <article class="card">
                    <h2>Order #<%= order.id %></h2>
                    <p class="muted"><%= new Date(order.createdAt).toLocaleString() %></p>
                    <ul>
                        <% order.items.forEach((item) => { %>
                            <li><%= item.name %> &times; <%= item.quantity %> — $<%= (Number(item.price) * Number(item.quantity)).toFixed(2) %></li>
                        <% }); %>
                    </ul>
                    <p><strong>Total: $<%= Number(order.total).toFixed(2) %></strong></p>
                </article>
            <% }); %>
        </div>
    <% } %>
</main>
<%- include("footer") %>
